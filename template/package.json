{
  "name": "hbn-rn-template",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade React Native 0.87 starter template.",
  "author": {
    "name": "Hussam Bin Noor",
    "url": "https://github.com/hussambinnoor"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hussambinnoor/hbn-rn-template"
  },
  "license": "MIT",
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --variant=release",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "pods": "cd ios && bundle install && bundle exec pod install && cd ..",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf node_modules ios/Pods android/build android/app/build",
    "hooks:install": "node scripts/commit-guard/install-hooks.js",
    "template:ack": "node scripts/commit-guard/acknowledge.js",
    "lint:rules": "eslint . --cache",
    "lint:code-format": "prettier --check \"{src,__mocks__}/**/*.{js,json,md,ts,tsx,yml,yaml}\"",
    "lint:type-check": "tsc",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "pod-install": "npx pod-install",
    "generate-apk": "cd android && ./gradlew app:assembleRelease",
    "debug-apk": "cd android && ./gradlew app:assembleDebug && open android/app/build/outputs/apk/debug",
    "temp-release": "yarn generate-apk && yarn open-explorer",
    "open-explorer": "open android/app/build/outputs/apk/release",
    "pod": "cd ios && pod install && cd ..",
    "android-release": "react-native run-android --variant=release"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.14",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.104.4",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "lucide-react-native": "1.59.0",
    "react": "19.2.3",
    "react-hook-form": "7.90.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.4.0",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.1",
    "jest": "^29.6.3",
    "prettier": "3.4.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">= 22.13.0"
  }
}
